    <!-- A half-height-in-plan partition keeps the southern navigation corridor
         open while separating the west living room from the east kitchen. -->
    <model name="living_kitchen_partition">
      <static>true</static>
      <pose>1.25 4.325 1.20 0 0 0</pose>
      <link name="partition_link">
        <collision name="partition_collision">
          <geometry><box><size>0.18 2.75 2.40</size></box></geometry>
