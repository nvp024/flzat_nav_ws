<?xml version="1.0"?>
<sdf version="1.9">
  <!--
    Lightweight indoor home for RGB-D / VLM experiments.

    Design constraints:
    - Self-contained: no remote includes, meshes, or texture URIs.
    - Primitive visual and collision geometry only.
    - All environment objects are static to keep physics inexpensive.
    - Semantic model names are kept distinct for future annotations.
    - Clear reference spawn area at (-5.0, -3.5, 0.0), facing +X.
  -->
  <world name="indoor_home_vlm">
    <physics name="fixed_1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <gravity>0 0 -9.80665</gravity>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Reuse the warm neutral scene palette from the hotel demo. -->
    <scene>
      <ambient>0.62 0.58 0.53 1</ambient>
      <background>0.16 0.18 0.22 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="living_room_light" type="point">
      <pose>-4 1.0 4.0 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>1.0 0.84 0.68 1</diffuse>
      <specular>0.16 0.14 0.12 1</specular>
      <attenuation>
        <range>13</range>
        <constant>0.75</constant>
        <linear>0.035</linear>
        <quadratic>0.002</quadratic>
      </attenuation>
    </light>

    <light name="kitchen_light" type="point">
      <pose>4 1.0 4.0 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <diffuse>0.92 0.94 1.0 1</diffuse>
      <specular>0.16 0.16 0.18 1</specular>
      <attenuation>
        <range>13</range>
        <constant>0.75</constant>
        <linear>0.035</linear>
        <quadratic>0.002</quadratic>
      </attenuation>
    </light>

    <!-- ========================= ARCHITECTURE ========================= -->

    <model name="home_floor">
      <static>true</static>
      <link name="floor_link">
        <collision name="floor_collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>16 12</size></plane>
          </geometry>
          <surface>
            <friction>
              <ode><mu>1.2</mu><mu2>1.2</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="floor_visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>16 12</size></plane>
          </geometry>
          <material>
            <ambient>0.55 0.49 0.42 1</ambient>
            <diffuse>0.70 0.63 0.54 1</diffuse>
            <specular>0.12 0.12 0.12 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="living_room_rug">
      <static>true</static>
      <pose>-4.5 2.35 0.007 0 0 0</pose>
      <link name="rug_link">
        <visual name="rug_visual">
          <geometry><box><size>5.0 4.0 0.014</size></box></geometry>
          <material>
            <ambient>0.12 0.25 0.29 1</ambient>
            <diffuse>0.18 0.42 0.47 1</diffuse>
            <specular>0.02 0.02 0.02 1</specular>
          </material>
        </visual>
        <visual name="rug_center_stripe">
          <pose>0 0 0.009 0 0 0</pose>
          <geometry><box><size>4.3 0.12 0.006</size></box></geometry>
          <material>
            <ambient>0.74 0.54 0.18 1</ambient>
            <diffuse>0.92 0.70 0.25 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="kitchen_floor_inlay">
      <static>true</static>
      <pose>4.35 0 0.006 0 0 0</pose>
      <link name="inlay_link">
        <visual name="inlay_visual">
          <geometry><box><size>6.9 11.2 0.012</size></box></geometry>
          <material>
            <ambient>0.64 0.64 0.61 1</ambient>
            <diffuse>0.80 0.80 0.76 1</diffuse>
            <specular>0.18 0.18 0.18 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="north_wall">
